PORT=3000
FIREBASE_DATABASE_URL=https://seafood-smart-default-rtdb.asia-southeast1.firebasedatabase.app
GOOGLE_CLOUD_PROJECT=seafood-smart
# Set to an absolute path outside this repository for local development.
GOOGLE_APPLICATION_CREDENTIALS=
# Comma-separated browser origins. Leave empty for requests without an Origin.
CORS_ORIGINS=
# Run exactly one worker for each pond. Comma-separated pond IDs.
PUSH_PONDS=pond01

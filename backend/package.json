{
  "name": "seafood-smart-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test test/validation.test.mjs test/push-token.test.mjs test/http.test.mjs",
    "test:rules": "firebase emulators:exec --project demo-seafood-smart --only database --config firebase.emulator.json \"node --test test/firebase-rules.test.mjs\"",
    "check:firebase": "tsx src/check-firebase.ts",
    "worker": "node dist/push-worker.js",
    "worker:dev": "tsx src/push-worker.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "firebase-admin": "^14.5.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/swagger-ui-express": "^4.1.7",
    "firebase": "^13.4.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
